# Copy these values to Cloudflare Worker runtime variables/secrets.
# Never commit a file containing your actual Google client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact deployed HTTPS origin, without a trailing slash.
AUTH_ORIGIN=
# Verified Google email(s) authorized to manage the store.
ADMIN_EMAILS=

# Product photo storage (server-side only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
